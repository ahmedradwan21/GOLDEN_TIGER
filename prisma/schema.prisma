generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  phone        String?
  passwordHash String     @map("password_hash")
  orders       Order[]
  clickLogs    ClickLog[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

model Admin {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String     @map("password_hash")
  role         AdminRole  @default(ADMIN)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("admins")
}

model Category {
  id        String     @id
  name      String
  slug      String     @unique
  imageUrl  String?    @map("image_url")
  sortOrder Int        @default(0) @map("sort_order")
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id               String      @id
  slug             String      @unique
  title            String
  brand            String?
  sku              String?     @unique
  shortDescription String?     @map("short_description")
  description      String      @db.Text
  features         String[]
  specifications   Json?
  priceCents       Int         @map("price_cents")
  compareAtCents   Int?        @map("compare_at_cents")
  currency         String      @default("USD")
  stock            Int         @default(0)
  images           String[]
  videoUrls        String[]    @map("video_urls")
  rating           Float       @default(0)
  reviewCount      Int         @default(0) @map("review_count")
  seoTitle         String?     @map("seo_title")
  seoDescription   String?     @map("seo_description")
  seoKeywords      String?     @db.Text @map("seo_keywords")
  tags             String[]
  isPublished      Boolean     @default(true) @map("is_published")
  categoryId       String      @map("category_id")
  category         Category    @relation(fields: [categoryId], references: [id])
  orderItems       OrderItem[]
  clickLogs        ClickLog[]
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([isPublished, createdAt])
  @@index([priceCents])
  @@index([rating])
  @@index([tags], type: Gin)
  @@map("products")
}

enum OrderStatus {
  CHECKOUT_STARTED @map("CHECKOUT_STARTED")
  COMPLETED        @map("COMPLETED")
  CANCELLED        @map("CANCELLED")
  ABANDONED        @map("ABANDONED")
}

model Order {
  id                String        @id @default(uuid()) @db.Uuid
  orderNumber       String?       @unique @map("order_number")
  sessionId         String        @map("session_id")
  userId            String?       @map("user_id")
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status            OrderStatus   @default(CHECKOUT_STARTED)
  email             String?
  shippingAddress   Json?         @map("shipping_address")
  deliveryMethod    String?       @map("delivery_method")
  subtotalCents     Int           @map("subtotal_cents")
  taxCents          Int           @default(0) @map("tax_cents")
  shippingCents     Int           @default(0) @map("shipping_cents")
  totalCents        Int           @map("total_cents")
  currency          String        @default("USD")
  paymentMethod     String?       @map("payment_method")
  paymentRef        String?       @map("payment_ref")
  items             OrderItem[]
  checkoutStartedAt DateTime      @default(now()) @map("checkout_started_at")
  completedAt       DateTime?     @map("completed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([sessionId])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @map("order_id")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?  @map("product_id")
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  titleSnapshot   String   @map("title_snapshot")
  imageSnapshot   String?  @map("image_snapshot")
  unitPriceCents  Int      @map("unit_price_cents")
  quantity        Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum ClickEventType {
  VISIT       @map("VISIT")
  IMPRESSION  @map("IMPRESSION")
  VIEW        @map("VIEW")
  CLICK       @map("CLICK")
  ADD_TO_CART @map("ADD_TO_CART")
}

model ClickLog {
  id         Int            @id @default(autoincrement())
  eventType  ClickEventType @map("event_type")
  productId  String?        @map("product_id")
  product    Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  sessionId  String         @map("session_id")
  userId     String?        @map("user_id")
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  path       String
  source     String?
  referrer   String?
  userAgent  String?        @map("user_agent")
  deviceType String?        @map("device_type")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([productId, eventType, createdAt])
  @@index([eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@map("click_logs")
}
