# ---- Supabase (Project Settings -> API) ----
# Must be the https:// project URL; also used to build the Content-Security-Policy at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth ----
# REQUIRED: at least 32 characters (random). Generate with: openssl rand -base64 48
JWT_SECRET=
# Bootstrap admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---- Site ----
# Public base URL (sitemap, robots, links), no trailing slash
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- Optional ----
# Facebook Pixel ID (leave empty to disable tracking)
NEXT_PUBLIC_FB_PIXEL_ID=
# Telegram order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
